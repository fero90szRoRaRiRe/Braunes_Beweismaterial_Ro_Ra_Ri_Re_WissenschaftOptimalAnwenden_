from dataclasses import dataclass

@dataclass
class Ro:
    bewegung: float

@dataclass
class Ra:
    verarbeitung: float

@dataclass
class Ri:
    zusammenhang: float

@dataclass
class Re:
    umgebung: float

@dataclass
class System:
    Ro: Ro
    Ra: Ra
    Ri: Ri
    Re: Re


system = System(
    Ro(10.0),
    Ra(20.0),
    Ri(30.0),
    Re(40.0)
)

print(system.Ro.bewegung)
print(system.Ra.verarbeitung)
print(system.Ri.zusammenhang)
print(system.Re.umgebung)
