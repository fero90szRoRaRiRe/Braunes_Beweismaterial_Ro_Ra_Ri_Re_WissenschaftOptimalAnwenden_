<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Stadtkarte mit rotierendem Wappen</title>
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
--bg:#f4efe6;--ink:#2a2118;--muted:#7a6c5a;--map:#e6dfcf;--grid:#d3c9b3;--road:#fffaf0;--hole:#b9ae96;--city:#f8f3e8;--water:#9cc3e0;--red:#b3262e;--silver:#e9e6df;--gold:#c9a227;--line:#2a2118}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#16130f;--ink:#f1e9da;--muted:#a69882;--map:#262119;--grid:#383124;--road:#3a3326;--hole:#0e0c09;--city:#3b3427;--water:#2d5372;--red:#d23a42;--silver:#d8d4ca;--gold:#e0b93a;--line:#f1e9da}}
:root[data-theme="dark"]{--bg:#16130f;--ink:#f1e9da;--muted:#a69882;--map:#262119;--grid:#383124;--road:#3a3326;--hole:#0e0c09;--city:#3b3427;--water:#2d5372;--red:#d23a42;--silver:#d8d4ca;--gold:#e0b93a;--line:#f1e9da}
*,*:before,*:after{box-sizing:inherit}
html,body{margin:0;background:var(--bg);color:var(--ink);font-family:Georgia,"Times New Roman",serif}
body{display:flex;flex-direction:column;align-items:center;gap:1rem;padding:1rem}
h1{margin:0;font-size:clamp(1.3rem,5vw,1.8rem);letter-spacing:.3em;text-transform:uppercase;padding-left:.3em}
.sub{margin:0;color:var(--muted);font-size:.75rem;letter-spacing:.15em;text-transform:uppercase;text-align:center}
.map{position:relative;width:min(92vw,480px);aspect-ratio:1;border-radius:14px;overflow:hidden;border:2px solid var(--line)}
.map>svg{position:absolute;inset:0;width:100%;height:100%}
.stage{position:absolute;left:12.5%;top:12.5%;width:75%;height:75%;perspective:1000px}
.coin{width:100%;height:100%;animation:spin 8s linear infinite;transform-style:preserve-3d;filter:drop-shadow(0 10px 10px rgba(0,0,0,.4))}
.coin svg{width:100%;height:100%;display:block}
@keyframes spin{to{transform:rotateY(360deg)}}
.tip{position:absolute;left:50%;top:94.7%;width:0;height:0;pointer-events:none}
.bar{position:absolute;top:0;height:6px;border-radius:3px;border:1px solid rgba(128,128,128,.55)}
.legend{display:grid;grid-template-columns:1fr 1fr;gap:.5rem;width:min(92vw,480px)}
.item{display:flex;align-items:center;gap:.6rem;padding:.5rem .6rem;border:1px solid var(--grid);border-radius:10px;opacity:.55;transition:opacity .25s,border-color .25s}
.item.on{opacity:1;border-color:var(--ink)}
.item b{font-size:1.1rem;min-width:1.8rem}
.item small{display:block;color:var(--muted);font-size:.7rem;line-height:1.25}
.chips{display:flex;flex-direction:column;gap:3px}
.chip{display:flex;width:34px;height:8px;border-radius:4px;overflow:hidden;border:1px solid rgba(128,128,128,.55)}
.chip i{flex:1}
@media (prefers-reduced-motion:reduce){.coin{animation-duration:30s}}
</style>
</head>
<body>
<h1 id="city">Hannover</h1>
<p class="sub">Stadtgebiet ausgeschnitten, schematische Umrisse</p>

<div class="map">
  <svg viewBox="0 0 400 400" preserveAspectRatio="none" aria-hidden="true">
    <rect width="400" height="400" fill="var(--map)"/>
    <g stroke="var(--grid)" stroke-width="1"><path d="M0 50H400M0 100H400M0 150H400M0 200H400M0 250H400M0 300H400M0 350H400M50 0V400M100 0V400M150 0V400M200 0V400M250 0V400M300 0V400M350 0V400"/></g>
    <g stroke="var(--road)" stroke-width="5" fill="none" stroke-linecap="round"><path d="M0 120 C120 150 260 90 400 130"/><path d="M60 400 C140 260 250 180 340 0"/><path d="M0 300 C140 280 260 340 400 290"/></g>
    <g transform="translate(50,50)"><polygon points="150,28 190,34 222,58 250,52 268,90 262,128 278,158 258,196 232,206 222,242 186,262 150,284 116,262 80,246 58,212 34,190 40,150 30,112 62,92 78,58 112,40" fill="var(--hole)"/></g>
  </svg>

  <div class="stage">
    <div class="coin">
      <svg viewBox="0 0 300 300" role="img" aria-label="Ausgeschnittenes Stadtgebiet mit Wappen">
        <polygon points="150,28 190,34 222,58 250,52 268,90 262,128 278,158 258,196 232,206 222,242 186,262 150,284 116,262 80,246 58,212 34,190 40,150 30,112 62,92 78,58 112,40" fill="var(--city)" stroke="var(--line)" stroke-width="3" stroke-linejoin="round"/>
        <path d="M112 66 C124 110 108 150 122 190 C132 220 120 240 130 262" fill="none" stroke="var(--water)" stroke-width="5" stroke-linecap="round"/>
        <ellipse cx="168" cy="226" rx="26" ry="8" fill="var(--water)" stroke="var(--line)" stroke-width="1.5"/>
        <g transform="translate(102,88) scale(.48)">
          <path d="M45 52 V22 h14 v8 h14 v-8 h14 v8 h14 v-8 h14 v8 h14 v-8 h14 V52 Z" fill="var(--gold)" stroke="var(--line)" stroke-width="3" stroke-linejoin="round"/>
          <path d="M22 62 H178 V140 C178 188 140 214 100 232 C60 214 22 188 22 140 Z" fill="var(--silver)"/>
          <path d="M100 62 H178 V140 C178 188 140 214 100 232 Z" fill="var(--red)"/>
          <path d="M22 62 H178 V140 C178 188 140 214 100 232 C60 214 22 188 22 140 Z" fill="none" stroke="var(--line)" stroke-width="4" stroke-linejoin="round"/>
          <path d="M72 175 V108 h10 v8 h12 v-8 h12 v8 h12 v-8 h10 V175 Z" fill="var(--gold)" stroke="var(--line)" stroke-width="3" stroke-linejoin="round"/>
          <path d="M90 175 V150 a10 10 0 0 1 20 0 V175 Z" fill="var(--line)"/>
        </g>
      </svg>
    </div>
    <div class="tip" id="tip"></div>
  </div>
</div>

<div class="legend" id="legend"></div>

<script>
const PAIRS=[["#d23a42","#111111"],["#ffffff","#111111"],["#ffffff","#f2c500"],["#ffffff","#1f9d55"],["#7b3fa0","#111111"],["#111111","#ffffff"],["#ffffff","#2a6fdb"],["#ffffff","#1f9d55"]];
const MODE="Ri"; // "Ro" = alle links lang, "Ri" = abwechselnd, "Legende" = je nach Ro/Ra/Ri/Re
const NAMES=["Ro","Ra","Ri","Re"];
const TEXT=["links lang","beide gleich lang","abwechselnd","rechts lang"];
const tip=document.getElementById("tip"),legend=document.getElementById("legend"),SPIN=8000,STEP=SPIN/PAIRS.length;
NAMES.forEach((n,k)=>{
  const chips=[k,k+4].map(i=>'<span class="chip"><i style="background:'+PAIRS[i][0]+'"></i><i style="background:'+PAIRS[i][1]+'"></i></span>').join("");
  legend.insertAdjacentHTML("beforeend",'<div class="item" id="it'+k+'"><b>'+n+'</b><div class="chips">'+chips+'</div><small>'+TEXT[k]+'</small></div>');
});
function emit(i){
  const k=i%4,[a,b]=PAIRS[i],map=tip.closest(".map").clientWidth,long=map*0.34,short=long*0.35;
  let L,R;
  if(k===0){L=long;R=short}                       // Ro: links lang
  else if(k===1){L=R=(long+short)/2}              // Ra: gleich lang
  else if(k===2){const f=Math.floor(i/4)%2===0;L=f?long:short;R=f?short:long} // Ri: abwechselnd
  else{L=short;R=long}                            // Re: rechts lang
  if(MODE==="Ro"){L=long;R=short}
  if(MODE==="Ri"){const f=i%2===0;L=f?long:short;R=f?short:long}
  document.querySelectorAll(".item").forEach((e,j)=>e.classList.toggle("on",j===k));
  const mk=(c,len,side)=>{const e=document.createElement("div");e.className="bar";e.style.background=c;e.style.width=len+"px";
    e.style[side==="L"?"right":"left"]="0";e.style.transformOrigin=side==="L"?"right":"left";tip.appendChild(e);
    const y=i*2;
    e.animate([{transform:"translateY("+y+"px) scaleX(0)",opacity:1},{transform:"translateY("+(y+8)+"px) scaleX(1)",opacity:1,offset:.35},{transform:"translateY("+(y+26)+"px) scaleX(1)",opacity:0}],{duration:STEP*2.4,easing:"ease-out"}).onfinish=()=>e.remove();};
  mk(a,L,"L");mk(b,R,"R");
}
let n=0;emit(n++%8);setInterval(()=>emit(n++%8),STEP);
</script>
</body>
</html>
